# Получите новый токен в BotFather. Секреты храните только в локальном .env.
TELEGRAM_BOT_TOKEN=
# Основной режим по условию задания — официальный DeepSeek.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
SESSION_TTL_SECONDS=1800
RAG_TRANSLATION=on
BOT_CONCURRENCY=8
RAG_SEARCH_MODE=hybrid
RAG_LEXICAL_WEIGHT=1.0
RAG_REPAIR_QUOTES=off
# Дополнительная проверка смысла утверждений: +1 API-вызов на подготовленный ответ.
RAG_VERIFY_CLAIMS=on

# Experimental local reranker: enable after comparing retrieval on your questions.
RAG_RERANK=off
RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANK_CANDIDATES=24
RAG_RERANK_DEVICE=cpu
# Adds a field to the existing verification call (no extra call if CLAIMS=on).
RAG_VERIFY_RELEVANCE=off
